@model List<CourseManagement>

@{
    ViewData["Title"] = "Courses";
    var role = Context.Session.GetString("UserRole");
}

@if (TempData["Error"] != null)
{
    <div class="edu-alert danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="edu-page-header">
    <div>
        <h1 class="edu-page-title">Course Management</h1>
        <p class="edu-page-subtitle">Catalog of courses and fees</p>
    </div>
    @if (role == "Admin")
    {
        <a asp-action="Create" class="btn-edu-primary">
            <i class="bi bi-plus-lg"></i> Add New Course
        </a>
    }
</div>

<div class="edu-card">
    <div class="edu-card-header">
        <span class="edu-card-title">All Courses</span>
        <span class="edu-muted" style="font-size:12px;">@Model.Count total</span>
    </div>
    <div class="edu-table-wrap">
        <table class="edu-table">
            <thead>
                <tr>
                    <th>Course Name</th>
                    <th>Semester</th>
                    <th>Fees</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td style="font-weight:600;">@course.CourseName</td>
                        <td>@course.Semester</td>
                        <td>₹ @course.Fees</td>
                        <td class="text-center">
                            <div class="edu-actions">
                                <a asp-action="Details" asp-route-id="@course.CourseId" class="btn-edu-outline btn-edu-sm">View</a>
                                @if (role == "Admin")
                                {
                                    <a asp-action="Edit"   asp-route-id="@course.CourseId" class="btn-edu-ghost btn-edu-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@course.CourseId" class="btn-edu-danger btn-edu-sm">Delete</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center edu-muted" style="padding:24px;">No courses yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

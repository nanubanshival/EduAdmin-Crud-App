@using CrudProject.ViewModel;
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<h2 class="edu-auth-title">Set a new password</h2>

<form asp-action="ChangePassword" asp-controller="Account" method="post">
    <div asp-validation-summary="ModelOnly" class="edu-validation-summary"></div>

    <div class="edu-form-group">
        <label asp-for="Email" class="edu-label">Email</label>
        <input asp-for="Email" class="edu-input" readonly />
    </div>

    <div class="edu-form-group">
        <label asp-for="NewPassword" class="edu-label">New Password</label>
        <input asp-for="NewPassword" class="edu-input" type="password" placeholder="At least 8 characters" />
        <span asp-validation-for="NewPassword" class="edu-field-error"></span>
    </div>

    <div class="edu-form-group">
        <label asp-for="ConfirmNewPassword" class="edu-label">Confirm New Password</label>
        <input asp-for="ConfirmNewPassword" class="edu-input" type="password" placeholder="Re-type password" />
        <span asp-validation-for="ConfirmNewPassword" class="edu-field-error"></span>
    </div>

    <button type="submit" class="btn-edu-primary edu-w-full">Update Password</button>

    <p class="edu-auth-footer">
        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </p>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

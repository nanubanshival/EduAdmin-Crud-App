@model IEnumerable<CrudProject.Models.LeaveBalances>

@{
    ViewData["Title"] = "Leave Balances";
}

<div class="edu-page-header">
    <div>
        <h1 class="edu-page-title">Leave Balances</h1>
        <p class="edu-page-subtitle">Per-teacher annual leave usage</p>
    </div>
    <div class="edu-flex edu-gap-2">
        <a asp-controller="Leave" asp-action="LeaveTypes"        class="btn-edu-outline">Leave Types</a>
        <a asp-controller="Leave" asp-action="LeaveApplications" class="btn-edu-outline">Applications</a>
    </div>
</div>

<div class="edu-card">
    <div class="edu-card-header">
        <span class="edu-card-title">Balances</span>
    </div>
    <div class="edu-table-wrap">
        <table class="edu-table">
            <thead>
                <tr>
                    <th>Teacher</th>
                    <th>Leave Type</th>
                    <th>Year</th>
                    <th>Total</th>
                    <th>Used</th>
                    <th>Remaining</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TeacherId</td>
                        <td>@item.LeaveTypeId</td>
                        <td>@item.Year</td>
                        <td>@item.TotalLeaves</td>
                        <td>@item.UsedLeaves</td>
                        <td><span style="font-weight:700; color:var(--primary-600);">@item.RemainingLeaves</span></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center edu-muted" style="padding:24px;">No balances on record.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

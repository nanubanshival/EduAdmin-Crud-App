@model CrudProject.Models.Teachers

@{
    ViewData["Title"] = "Teacher Details";
}

<div class="edu-page-header">
    <div>
        <h1 class="edu-page-title">Teacher Details</h1>
        <p class="edu-page-subtitle">@Model.Name</p>
    </div>
    <div class="edu-flex edu-gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.TeacherId" class="btn-edu-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn-edu-outline">Back to List</a>
    </div>
</div>

<div class="edu-card" style="max-width:680px;">
    <div class="edu-details-grid">
        <div class="edu-detail-label">@Html.DisplayNameFor(m => m.Name)</div>
        <div class="edu-detail-value">@Model.Name</div>

        <div class="edu-detail-label">@Html.DisplayNameFor(m => m.Email)</div>
        <div class="edu-detail-value">@Model.Email</div>

        <div class="edu-detail-label">@Html.DisplayNameFor(m => m.Phone)</div>
        <div class="edu-detail-value">@Model.Phone</div>

        <div class="edu-detail-label">@Html.DisplayNameFor(m => m.Salary)</div>
        <div class="edu-detail-value">₹ @Model.Salary</div>

        <div class="edu-detail-label">@Html.DisplayNameFor(m => m.JoiningDate)</div>
        <div class="edu-detail-value">@Model.JoiningDate.ToString("dd MMM yyyy")</div>

        <div class="edu-detail-label">@Html.DisplayNameFor(m => m.IsActive)</div>
        <div class="edu-detail-value">
            @if (Model.IsActive)
            {
                <span class="badge-edu success">Active</span>
            }
            else
            {
                <span class="badge-edu danger">Inactive</span>
            }
        </div>
    </div>
</div>
